# Runtime data and secrets - never copied into the image
**/data/*
**/data/.secret_key
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db.demo
**/.secret_key

# Environment
**/.env
**/.env.local
!**/.env.example

# Caches, tests output, build
**/.pytest_cache/
**/.ruff_cache/
**/__pycache__/
**/*.pyc
**/venv/
**/.venv/
**/node_modules/
.git

# IDE
.idea/
.vscode/
