# Runtime data and secrets - never commit or ship these
**/data/*
!**/data/.gitkeep
!**/data/README.txt
**/data/.secret_key
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db.demo
.secret_key

# Environment
.env
**/.env
.env.local
!**/.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
venv/
.venv/

# Node
node_modules/

# IDE
.idea/
.vscode/
*.swp
