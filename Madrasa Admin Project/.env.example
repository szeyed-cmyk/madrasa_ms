# Madrasa Pro 1.0.8 - example environment (placeholders only; never commit a real .env).
# The SAME file ships in the archive root (docker compose) and in "Madrasa Admin Project/" (local run).
# Copy it to .env next to it. docker compose also starts without a .env (env_file required: false).

# --- Server (docker compose / render.yaml override HOST=0.0.0.0 and DATABASE_PATH) ---
HOST=127.0.0.1
PORT=8000

# --- Database: SQLite file, created automatically (folder too) on first start ---
DATABASE_PATH=data/madrasa.db

# --- Security ---
# Session signing key. Empty = generated once at runtime into data/.secret_key (never shipped).
# Production: set a long random value: python -c "import secrets; print(secrets.token_hex(32))"
# 1.0.5: it also encrypts the SMTP password and payment/SMS API secrets saved in Settings. Keep it
# stable: if it changes, those secrets can no longer be read and must be entered again.
SECRET_KEY=
# true when served over HTTPS (production). Not allowed together with DEMO_MODE=true.
COOKIE_SECURE=false
SESSION_HOURS=12
PBKDF2_ITERATIONS=600000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# --- Demo sign-in box (ON by default when this variable is omitted) ---
# WARNING: If DEMO_LOGINS is unset, it defaults to true. The login page shows three demo accounts
# (demo.admin / Admin@2026, demo.karim / Teacher@2026, demo.student / Student@2026) and those
# accounts are created if missing. This does not wipe your database.
# Set DEMO_LOGINS=false for real school data (hides the boxes and disables those three accounts).
DEMO_LOGINS=false
# SEED_DEMO_DATA=true loads sample students, marks, attendance, timetable and fees on first start.
SEED_DEMO_DATA=false
# DEMO_MODE=true (public demo only) WIPES the database and re-seeds a sample school on every start,
# and also shows the Demo sign-in box. The app refuses to start with it when COOKIE_SECURE=true,
# SEED_DEMO_DATA=false or ADMIN_USERNAME/ADMIN_PASSWORD are set, and it never wipes a database that
# holds real data. Use start-demo.bat / start-demo.sh for this on a PC.
DEMO_MODE=false
# Old name of DEMO_MODE (1.0.4), still accepted: either one set to true turns demo mode on.
DEMO_AUTO_LOGIN=false

# --- Optional bootstrap admin (empty = create the admin on the /setup page) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
